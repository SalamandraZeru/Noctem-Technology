---
import SignalArt from './SignalArt.astro';
import ProjectCard from './ProjectCard.astro';
import { copy } from '../data/i18n';
import { routeFor } from '../data/routes';
import { site, whatsappUrl } from '../data/site';
import { portfolioProjects } from '../data/projects';
interface Props { lang: 'pt' | 'en'; }
const { lang } = Astro.props;
const t = copy[lang];
const pt = lang === 'pt';
const services = pt ? [
  ['01', 'Apps', 'Produtos digitais claros, responsivos e preparados para evoluir.', 'preview-apps'],
  ['02', 'Sites', 'Presenças rápidas e autorais, construídas para comunicar e converter.', 'preview-sites'],
  ['03', 'Softwares', 'Sistemas sob medida que organizam operações e aproximam informações.', 'preview-software'],
  ['04', 'Automações', 'Fluxos e integrações que reduzem tarefas repetitivas com controle.', 'preview-automation'],
] : [
  ['01', 'Apps', 'Clear, responsive digital products designed to grow.', 'preview-apps'],
  ['02', 'Websites', 'Fast, distinctive presences built to communicate and convert.', 'preview-sites'],
  ['03', 'Software', 'Purpose-built systems that organize operations and connect information.', 'preview-software'],
  ['04', 'Automation', 'Controlled workflows and integrations that reduce repetitive work.', 'preview-automation'],
];
const process = pt ? [
  ['Imersão', 'Entendemos contexto, objetivo, público e restrições.'], ['Direção', 'Definimos mensagem, arquitetura e linguagem visual.'], ['Construção', 'Design, código e integrações avançam como um sistema.'], ['Validação', 'Revisamos responsividade, acessibilidade, SEO e desempenho.'], ['Publicação', 'Preparamos a entrada em produção e os próximos ciclos.'],
] : [
  ['Discovery', 'We understand context, goals, audience, and constraints.'], ['Direction', 'We define the message, architecture, and visual language.'], ['Build', 'Design, code, and integrations advance as one system.'], ['Validation', 'We review responsiveness, accessibility, SEO, and performance.'], ['Launch', 'We prepare production release and the next cycles.'],
];
const reel = [
  ['dom-pedro-desktop', 'Dom Pedro'], ['studio-bella-home', 'Studio Bella'], ['jk-copycenter-desktop', 'JK Copycenter'], ['eletrocl-desktop', 'EletroCL'],
  ['dom-pedro-gallery', 'Dom Pedro'], ['studio-bella-admin-dashboard', 'Studio Bella'], ['eletrocl-company', 'EletroCL'],
];
const clocks = pt ? [
  ['Brasil', 'America/Sao_Paulo'], ['Lisboa', 'Europe/Lisbon'], ['Nova York', 'America/New_York'], ['Tóquio', 'Asia/Tokyo'],
] : [
  ['Brazil', 'America/Sao_Paulo'], ['Lisbon', 'Europe/Lisbon'], ['New York', 'America/New_York'], ['Tokyo', 'Asia/Tokyo'],
];
const scenes = pt
  ? ['O sinal', 'Manifesto', 'Showreel', 'Projetos', 'Capacidades', 'Processo', 'Mundo', 'Créditos']
  : ['The signal', 'Manifesto', 'Showreel', 'Projects', 'Capabilities', 'Process', 'World', 'Credits'];
const credits = pt ? [
  ['Direção', 'Noctem Technology'], ['Roteiro', 'Estratégia e conteúdo'], ['Direção de arte', 'Design de interface'], ['Efeitos visuais', 'Motion e WebGL'], ['Locação', 'Mundial, online'], ['Estrelando', 'Seu próximo projeto'],
] : [
  ['Directed by', 'Noctem Technology'], ['Screenplay', 'Strategy and content'], ['Art direction', 'Interface design'], ['Visual effects', 'Motion and WebGL'], ['Location', 'Worldwide, online'], ['Starring', 'Your next project'],
];
---
<div class="scene-hud" aria-hidden="true" data-hud>
  <span class="hud-rec"><i></i>REC</span>
  <span class="hud-scene" data-hud-scene>SC 01</span>
  <span class="hud-label" data-hud-label>{scenes[0]}</span>
  <span class="hud-tc" data-hud-tc>00:00:00:00</span>
</div>

<section class="hero" data-hero data-scene="01" data-scene-label={scenes[0]}>
  <div class="hero-atmosphere"></div>
  <canvas class="lightfield" data-lightfield data-focus="0.76,0.6" aria-hidden="true"></canvas>
  <div class="hero-depth" aria-hidden="true"><i></i><i></i><i></i><i></i><b></b></div>
  <div class="anamorphic" aria-hidden="true"><i></i><i></i></div>
  <div class="hero-index" aria-hidden="true"><span>NOCTEM®</span><span>35° 49' S</span><span>SIGNAL / 001</span></div>
  <div class="hero-copy">
    <p class="eyebrow reveal">{pt ? 'Design · Tecnologia · Automação' : 'Design · Technology · Automation'}</p>
    <h1 class="display reveal" data-hero-title aria-label={pt ? 'Tecnologia que deixa sua marca.' : 'Technology that leaves a mark.'}>{pt ? <><span class="hero-line" data-hero-line>Tecnologia que </span><span class="hero-line hero-line-accent" data-hero-line><em>deixa sua marca.</em></span></> : <><span class="hero-line" data-hero-line>Technology that </span><span class="hero-line hero-line-accent" data-hero-line><em>leaves a mark.</em></span></>}</h1>
    <p class="hero-intro reveal">{pt ? 'Criamos apps, sites, softwares e automações que unem presença, desempenho e clareza.' : 'We create apps, websites, software, and automation that bring presence, performance, and clarity together.'}</p>
    <div class="hero-actions reveal"><a class="button" href={routeFor('projects', lang)} data-magnetic>{t.nav.projects}</a><a class="text-link" href={whatsappUrl(lang)} target="_blank" rel="noopener noreferrer">{t.common.whatsapp}<span>↗</span></a></div>
  </div>
  <SignalArt />
  <div class="scroll-cue"><span>{pt ? 'Role para começar' : 'Scroll to begin'}</span><i></i></div>
</section>

<section class="kinetic-band" aria-label={pt ? 'Design, código e automação' : 'Design, code, and automation'} data-kinetic>
  {pt ? <>
    <div class="kinetic-track track-forward"><span>DESIGN</span><i>·</i><span>CÓDIGO</span><i>·</i><span>AUTOMAÇÃO</span><i>·</i><span>DESIGN</span><i>·</i><span>CÓDIGO</span><i>·</i><span>AUTOMAÇÃO</span></div>
    <div class="kinetic-track track-reverse" aria-hidden="true"><span>SINAL</span><i>·</i><span>SISTEMA</span><i>·</i><span>EXPERIÊNCIA</span><i>·</i><span>SINAL</span><i>·</i><span>SISTEMA</span></div>
  </> : <>
    <div class="kinetic-track track-forward"><span>DESIGN</span><i>·</i><span>CODE</span><i>·</i><span>AUTOMATION</span><i>·</i><span>DESIGN</span><i>·</i><span>CODE</span><i>·</i><span>AUTOMATION</span></div>
    <div class="kinetic-track track-reverse" aria-hidden="true"><span>SIGNAL</span><i>·</i><span>SYSTEM</span><i>·</i><span>EXPERIENCE</span><i>·</i><span>SIGNAL</span><i>·</i><span>SYSTEM</span></div>
  </>}
</section>

<section class="manifesto" data-manifesto data-scene="02" data-scene-label={scenes[1]}>
  <div class="manifesto-inner">
    <p class="section-kicker"><span class="scene-number">02</span>{pt ? 'O que nos move' : 'What drives us'}</p>
    <h2 data-manifesto-text>{pt ? <>Design para ser <em>sentido.</em> Engenharia para continuar <em>funcionando.</em></> : <>Design to be <em>felt.</em> Engineering to keep <em>working.</em></>}</h2>
    <p data-manifesto-note>{pt ? 'A Noctem transforma necessidades reais em experiências digitais consistentes. Cada decisão visual tem uma razão; cada linha de código sustenta uma experiência.' : 'Noctem turns real needs into coherent digital experiences. Every visual decision has a reason; every line of code supports an experience.'}</p>
  </div>
</section>

<section class="reel" data-reel data-scene="03" data-scene-label={scenes[2]} aria-labelledby="reel-title">
  <div class="reel-sticky">
    <div class="reel-frame" data-reel-frame aria-hidden="true">
      <div class="reel-shots">
        {reel.map(([file, client], index) => <figure class:list={['reel-shot', { 'is-active': index === 0 }]} data-reel-shot data-client={client}><img src={`/assets/reel/${file}.webp`} width="1600" height="1000" alt="" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" /></figure>)}
      </div>
      <div class="reel-grade"></div>
      <div class="reel-bars"><i></i><i></i></div>
      <div class="reel-overlay">
        <span class="reel-rec"><i></i>REC</span>
        <span class="reel-tc" data-reel-timecode>00:00:00:00</span>
        <span class="reel-client"><small>{pt ? 'Cena' : 'Scene'}</small><b data-reel-client>{reel[0][1]}</b></span>
        <span class="reel-format">4K · 24 FPS · 2.39:1</span>
        <b class="reel-corner"></b><b class="reel-corner"></b><b class="reel-corner"></b><b class="reel-corner"></b>
      </div>
    </div>
    <div class="reel-title">
      <p class="section-kicker"><span class="scene-number">03</span>Showreel 2026</p>
      <h2 id="reel-title">{pt ? <>Cada projeto, <em>uma cena.</em></> : <>Every project, <em>a scene.</em></>}</h2>
      <p>{pt ? 'Telas reais, capturadas dos produtos em funcionamento.' : 'Real screens, captured from products in use.'}</p>
    </div>
  </div>
</section>

<section class="home-projects films section" data-films data-scene="04" data-scene-label={scenes[3]}>
  <div class="films-pin" data-films-pin>
    <div class="section-heading films-head">
      <div><p class="section-kicker"><span class="scene-number">04</span>{pt ? 'Projetos selecionados' : 'Selected projects'}</p><h2 data-split>{pt ? 'Cinco produtos, cinco sistemas visuais.' : 'Five products, five visual systems.'}</h2></div>
      <div class="films-meta"><span class="films-count" aria-hidden="true"><b data-films-count>01</b> / 0{portfolioProjects.length}</span><a class="text-link" href={routeFor('projects', lang)}>{pt ? 'Ver portfólio completo' : 'View full portfolio'} <span>↗</span></a></div>
    </div>
    <div class="films-viewport">
      <div class="portfolio-grid home-portfolio-grid films-track" data-films-track>
        {portfolioProjects.map((card, index) => <ProjectCard {lang} {card} {index} />)}
      </div>
    </div>
    <div class="films-progress" aria-hidden="true"><i data-films-progress></i></div>
  </div>
</section>

<section class="services section" data-services data-scene="05" data-scene-label={scenes[4]}>
  <div class="section-heading"><div><p class="section-kicker"><span class="scene-number">05</span>{pt ? 'Capacidades' : 'Capabilities'}</p><h2 data-split>{pt ? 'Do primeiro sinal ao produto em movimento.' : 'From the first signal to a product in motion.'}</h2></div><a class="text-link" href={routeFor('services', lang)}>{pt ? 'Explorar serviços' : 'Explore services'} <span>↗</span></a></div>
  <div class="service-list">{services.map(([n, title, text, preview]) => <article data-preview={preview}><span>{n}</span><h3><span class="roll" data-text={title}><span>{title}</span></span></h3><p>{text}</p><i aria-hidden="true">↗</i></article>)}</div>
  <div class="service-preview" aria-hidden="true" data-service-preview>
    {services.map(([, , , preview]) => <img src={`/assets/reel/${preview}.webp`} alt="" loading="lazy" decoding="async" data-preview-image={preview} />)}
  </div>
</section>

<section class="process section" data-process data-scene="06" data-scene-label={scenes[5]}>
  <div class="process-intro"><p class="section-kicker"><span class="scene-number">06</span>{pt ? 'Como trabalhamos' : 'How we work'}</p><h2 data-split>{pt ? 'Clareza antes da complexidade.' : 'Clarity before complexity.'}</h2><p>{pt ? 'Um processo direto, colaborativo e bem definido do primeiro contato à entrega.' : 'A direct, collaborative, well-defined process from the first conversation to delivery.'}</p><span class="process-ghost" aria-hidden="true" data-process-ghost>01</span></div>
  <div class="process-track">
    <div class="process-line" aria-hidden="true"><i data-process-fill></i></div>
    <ol class="process-list">{process.map(([title, text], index) => <li data-process-step={`0${index + 1}`}><span>0{index + 1}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol>
  </div>
</section>

<section class="worldwide section" data-world data-scene="07" data-scene-label={scenes[6]}>
  <div class="globe-wrap" aria-hidden="true"><canvas class="globe" data-globe></canvas></div>
  <div class="worldwide-copy">
    <p class="section-kicker"><span class="scene-number">07</span>{pt ? 'Mundial · Online' : 'Worldwide · Online'}</p>
    <h2 data-split>{pt ? <>Boas ideias não precisam estar no mesmo <em>fuso horário.</em></> : <>Good ideas do not need to share a <em>time zone.</em></>}</h2>
    <p>{pt ? 'Atendemos projetos online em qualquer região, com comunicação clara e etapas bem definidas.' : 'We work online with clients anywhere, using clear communication and well-defined stages.'}</p>
    <ul class="clocks" aria-label={pt ? 'Horário agora' : 'Local time now'}>
      {clocks.map(([city, zone]) => <li><span>{city}</span><time data-tz={zone}>--:--</time></li>)}
    </ul>
  </div>
</section>

<section class="final-cta section" data-credits data-scene="08" data-scene-label={scenes[7]}>
  <div class="cta-signal" aria-hidden="true"><i></i><i></i><i></i><b></b></div>
  <p class="section-kicker"><span class="scene-number">08</span>{pt ? 'Próximo sinal' : 'Next signal'}</p>
  <h2 data-split>{pt ? <>O que podemos <em>construir</em> juntos?</> : <>What can we <em>build</em> together?</>}</h2>
  <div class="cta-actions"><a class="button button-light" href={whatsappUrl(lang)} target="_blank" rel="noopener noreferrer" data-magnetic>{t.common.whatsapp}</a><a class="text-link" href={`mailto:${site.email}`}>{site.email}<span>↗</span></a></div>
  <dl class="credits" data-credits-roll>
    {credits.map(([role, name]) => <div><dt>{role}</dt><dd>{name}</dd></div>)}
  </dl>
</section>
