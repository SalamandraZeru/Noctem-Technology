---
import { site, whatsappUrl } from '../data/site';
import { routeFor } from '../data/routes';
interface Props { lang: 'pt' | 'en'; }
const { lang } = Astro.props;
---
<footer class="site-footer">
  <div>
    <a class="footer-mark" href={routeFor('home', lang)}><img src="/assets/noctem-symbol.webp" width="68" height="63" alt="" /><span>Noctem Technology</span></a>
    <p>{lang === 'pt' ? 'Tecnologia, design e automação para marcas que querem avançar.' : 'Technology, design, and automation for brands ready to move forward.'}</p>
  </div>
  <div class="footer-links">
    <a href={whatsappUrl(lang)} target="_blank" rel="noopener noreferrer">WhatsApp</a>
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
    <a href={site.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
    <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn · {site.linkedinHandle}</a>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} Noctem Technology</span>
    <span>{lang === 'pt' ? 'Atendimento mundial, online' : 'Worldwide, online service'}</span>
    <a href={routeFor('privacy', lang)}>{lang === 'pt' ? 'Política de privacidade' : 'Privacy policy'}</a>
  </div>
</footer>
