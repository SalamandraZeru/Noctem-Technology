// Cloudflare Workers (static assets) deploy config: `npm run build` produces ./dist,
// then Cloudflare runs `npx wrangler deploy`, which publishes that folder as-is.
// _headers and _redirects inside dist keep working. The name must match the project in the dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noctem-technology",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
